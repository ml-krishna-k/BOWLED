# =============================================================================
# Bowled — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# MongoDB connection string. Atlas users: Database → Connect → Drivers.
# Either:
#   (a) embed credentials in the URI:
#       mongodb+srv://USER:PASS@cluster0.xxx.mongodb.net/?appName=Cluster0
#       The server URL-encodes any special chars in PASS automatically.
#   (b) use separate MONGO_USER + MONGO_PASS below and put just the host:
#       mongodb+srv://cluster0.xxx.mongodb.net/?appName=Cluster0
#       This is the easier path when Atlas auto-generates a password with `@`,
#       `:`, `/`, `#` etc. — Mongoose handles encoding internally.
mongo_db_uri=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Optional — override credentials from mongo_db_uri. Use these instead of
# embedding the password in the URI if your password has special characters.
MONGO_USER=
MONGO_PASS=

# Target database name. Mongoose otherwise defaults to Mongo's "test" DB
# when the URI has no /<dbname> path segment, which trips up Atlas users
# scoped to a specific DB. Defaults to "bowled".
MONGO_DB=bowled

# JWT signing key. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotate by replacing — all existing tokens become invalid.
JWT_SECRET=replace-with-96-hex-chars

# ---- MSG91 (required in production; optional in dev) ------------------------
#
# Two supported modes — pick ONE:
#
#   A. OTP-WIDGET MODE (recommended)
#      Browser runs MSG91's widget, handles SMS + OTP entirely client-side,
#      hands the browser a signed access-token. Server only validates that
#      token. No IP-whitelist headaches.
#        Server-side:   MSG91_API_KEY + MSG91_WIDGET_ID
#        Client-side:   VITE_MSG91_WIDGET_ID + VITE_MSG91_TOKEN_AUTH
#
#   B. LEGACY API MODE
#      Server calls MSG91 REST API to send + verify. Needs IP whitelisting
#      on MSG91's side.
#        Server-side:   MSG91_API_KEY + MSG91_TEMPLATE_ID
#
# In NODE_ENV=production at least one mode must be fully configured or the
# server refuses to start. When neither is set (dev), the server falls back
# to a deterministic mock OTP (<last-4-of-phone>00).
MSG91_API_KEY=
MSG91_WIDGET_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=BOWLED
MSG91_COUNTRY_CODE=91

# ---- Cloudinary (image uploads) ---------------------------------------------

# Used by the admin menu editor to upload meal images. When ANY of the three is
# missing, POST /api/upload/image returns 503. Get values from
# cloudinary.com → Dashboard → "Account Details".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — folder all uploads get bucketed into. Default: "bowled".
CLOUDINARY_FOLDER=bowled

# ---- Optional ---------------------------------------------------------------

# API server port (default: 4000)
PORT=4000

# JWT lifetime (default: 30d). Format: "30d", "7d", "12h", "1h" etc.
JWT_EXPIRES_IN=30d

# Allowed origins for CORS. Comma-separated — list every frontend URL the
# API should accept requests from. Trailing slashes are normalised.
#   Dev only:  CORS_ORIGIN=http://localhost:5173
#   Dev + prod: CORS_ORIGIN=http://localhost:5173,https://bowled.app,https://www.bowled.app
CORS_ORIGIN=http://localhost:5173

# Comma-separated phones treated as admin on signup.
ADMIN_PHONES=9360113501

# Test phone allowlist — phone:otp pairs that bypass MSG91 entirely (in BOTH
# dev and prod). For QA / demo logins when you can't get real SMS. The phone
# must match VITE_TEST_PHONES on the frontend so the widget gets skipped.
# Format: "phone1:otp1,phone2:otp2". OTP can be 4–8 digits.
# ⚠ SECURITY: anyone who knows these pairs can log in. Remove for true launch.
TEST_PHONES=

# "development" | "production". Production refuses to start without MSG91
# credentials and a non-default JWT_SECRET.
NODE_ENV=development

# ---- Frontend (Vite) --------------------------------------------------------

# Override the API base URL in production builds. Leave blank in dev — Vite
# proxies /api/* to the server via vite.config.ts.
VITE_API_URL=

# MSG91 OTP widget — both values come from the MSG91 dashboard → Widget panel.
# Both are SAFE to expose in the client bundle (the actual Auth Key, used for
# server-side token verification, stays in MSG91_API_KEY and never leaves the
# server). When these are absent the frontend falls back to the legacy
# server-side OTP flow.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# Comma-separated 10-digit phones that bypass the MSG91 widget (test/demo).
# Must mirror the phone half of TEST_PHONES on the server. The OTP itself
# is enforced server-side — listing a phone here just tells the frontend
# to skip loading the widget for it.
VITE_TEST_PHONES=
