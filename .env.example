# =============================================================================
# Bowled — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# MongoDB connection string. Atlas users: Database → Connect → Drivers.
# Either:
#   (a) embed credentials in the URI:
#       mongodb+srv://USER:PASS@cluster0.xxx.mongodb.net/?appName=Cluster0
#       The server URL-encodes any special chars in PASS automatically.
#   (b) use separate MONGO_USER + MONGO_PASS below and put just the host:
#       mongodb+srv://cluster0.xxx.mongodb.net/?appName=Cluster0
#       This is the easier path when Atlas auto-generates a password with `@`,
#       `:`, `/`, `#` etc. — Mongoose handles encoding internally.
mongo_db_uri=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Optional — override credentials from mongo_db_uri.
MONGO_USER=
MONGO_PASS=

# Target database name. Mongoose otherwise defaults to Mongo's "test" DB.
MONGO_DB=bowled

# JWT signing key. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotate by replacing — all existing tokens become invalid.
JWT_SECRET=replace-with-96-hex-chars

# ---- Google OAuth (required for sign-in) ------------------------------------
#
# Set up:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID → "Web application"
#   3. Authorised JavaScript origins: http://localhost:5173, https://bowled.store
#   4. Authorised redirect URIs: not needed (we use the ID-token / popup flow)
#   5. Copy the Client ID below — same value goes into VITE_GOOGLE_CLIENT_ID.
#
# Production refuses to start without this. In dev the /api/auth/google route
# returns 503 until you set it.
GOOGLE_CLIENT_ID=

# Comma-separated emails auto-promoted to admin on first Google sign-in.
# Any subsequent sign-in from these emails keeps them admin. Removing an
# email here does NOT demote an existing admin (do that in the DB).
ADMIN_EMAILS=your-admin-email@gmail.com

# ---- Cloudinary (image uploads) ---------------------------------------------

# Used by the admin menu editor + payment screenshot upload. When ANY of the
# three is missing, POST /api/upload/* returns 503. Get values from
# cloudinary.com → Dashboard → "Account Details".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — folder all uploads get bucketed into. Default: "bowled".
CLOUDINARY_FOLDER=bowled

# ---- UPI payments (manual verification) -------------------------------------

# Your business UPI ID — the address users send payments to. Format:
# something like "krishna@oksbi" or "9876543210@paytm". Tested with any
# Indian bank / wallet UPI handle. When this is empty, new subscribers see a
# "payments not configured" message and can't create a subscription.
BUSINESS_UPI_ID=

# Name shown in the user's UPI app during payment. Defaults to "Bowled".
BUSINESS_NAME=Bowled

# ---- Optional ---------------------------------------------------------------

# API server port (default: 4000)
PORT=4000

# JWT lifetime (default: 30d). Format: "30d", "7d", "12h", "1h" etc.
JWT_EXPIRES_IN=30d

# Allowed origins for CORS. Comma-separated — list every frontend URL the
# API should accept requests from. Trailing slashes are normalised.
#   Dev only:  CORS_ORIGIN=http://localhost:5173
#   Dev + prod: CORS_ORIGIN=http://localhost:5173,https://bowled.store,https://www.bowled.store
CORS_ORIGIN=http://localhost:5173

# "development" | "production". Production refuses to start without a real
# JWT_SECRET and GOOGLE_CLIENT_ID.
NODE_ENV=development

# ---- Frontend (Vite) --------------------------------------------------------

# Override the API base URL in production builds. Leave blank in dev — Vite
# proxies /api/* to the server via vite.config.ts.
VITE_API_URL=

# Google OAuth Client ID — same value as GOOGLE_CLIENT_ID. Exposed to the
# browser. Safe to commit to git only if you don't mind everyone knowing
# your client id (you should add referer restrictions in Google Console).
VITE_GOOGLE_CLIENT_ID=
