# =============================================================================
# Bowled — .gitignore
# =============================================================================

# ---- Logs -------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Dependencies & build artifacts -----------------------------------------
node_modules
dist
dist-ssr
server/dist
*.tsbuildinfo
*.local

# ---- Environment & secrets — NEVER commit these -----------------------------
.env
.env.local
.env.*.local
server/.env
# Local TLS roots (Avast root cert, corporate CAs, etc.)
*.pem
*.key
*.pfx

# ---- Editor / IDE -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea
.fleet
.zed
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS junk ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Coverage / test artifacts ----------------------------------------------
coverage/
*.lcov
.nyc_output/

# ---- Docker runtime ---------------------------------------------------------
# Compose may write local volumes/state next to the file
.docker-data/

# ---- Design source files (large binaries — keep out of git) -----------------
*.fig
.fig_preview/
